# Example settings for server/.env
# Copy this file to .env in the same folder and fill in the values.
# The real .env is not stored in git. This file is documentation only;
# the server does not read it.

# ---- HTTP -------------------------------------------------------------
# Port the API listens on (default 40000). The client's Vite proxy points here.
PORT=40000

# ---- Main database (MySQL) — required, the server does not start without it
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- LES database — required, the server does not start without it
LES_HOST=
LES_PORT=3306
LES_USER=
LES_PASSWORD=
LES_NAME=

# ---- MES database
MES_HOST=
MES_PORT=3306
MES_USER=
MES_PASSWORD=
MES_NAME=

# ---- Notes database (snapshots, shift marks/photos, dictionaries).
# Optional at start: the server runs without it and reconnects automatically.
NOTES_HOST=
NOTES_PORT=3306
NOTES_USER=
NOTES_PASSWORD=
NOTES_NAME=

# ---- BMS database (launch_db). Optional: BMS pages report errors without it.
BMS_HOST=
BMS_PORT=3306
BMS_USER=
BMS_PASSWORD=
BMS_NAME=

# ---- Page passwords. REQUIRED: they exist only here, not in the code.
# If one is empty, the server still starts but logs a warning and refuses every
# action that needs it (as "wrong password").
# Main password: brigade report, VRT report, warranty, e-mail settings (Model Status)
BRIGADE_PASSWORD=
# Special password: dictionary import, brigade/VRT management, deleting line-defect photos
IMPORT_PASSWORD=
# Protection against guessing: after this many wrong passwords in 10 minutes a computer
# cannot enter passwords for 10 minutes (default 10). PASSWORD_GUARD=off disables it.
# PASSWORD_MAX_ATTEMPTS=10

# ---- E-mail (Exchange / SMTP). If host, user or password is empty, the server logs a
# warning at start and mail cannot be sent.
EXCHANGE_HOST=
EXCHANGE_USER=
EXCHANGE_PASS=
# Sender address (defaults to EXCHANGE_USER) and display name
EXCHANGE_FROM=
EXCHANGE_FROM_NAME=MBS Quality System
# Older names, used only when the EXCHANGE_* value is empty
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- OPC UA (PLC). Defaults are built into server.js.
OPC_ENDPOINT=opc.tcp://10.203.46.10:4840
# OPC_NODE_ID=
# Poll interval, ms (default 3000)
OPC_POLL_INTERVAL=3000
# Read errors in a row before reconnecting (default 5)
OPC_MAX_READ_ERRORS=5
# Pause before reconnecting, ms (default 5000)
OPC_RECONNECT_DELAY=5000

# ---- Nightly backup of the notes database (all its tables) and of server/uploads.
# Off unless BACKUP_DIR is set. Use a folder on another disk or a network share if possible.
# The first copy is made within a minute after start if today's time has already passed.
# BACKUP_DIR=D:\mbs-backup
# Time of day (server clock), default 03:30
# BACKUP_TIME=03:30
# How many days to keep database copies, default 14
# BACKUP_KEEP_DAYS=14
# Copy photos too (default true)
# BACKUP_UPLOADS=true
